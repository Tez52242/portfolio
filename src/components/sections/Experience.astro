---
import {
  experience,
  education,
  subeducation,
  type TimelineEntry,
} from '../../data/experience';
import { ui } from '../../data/ui';
import Section from '../Section.astro';

const groups: { title: string; entries: TimelineEntry[] }[] = [
  { title: ui.sections.experience, entries: experience },
  { title: ui.sections.education, entries: education },
  { title: 'Дополнительное образование', entries: subeducation },
].filter((g) => g.entries.length > 0);
---

{
  groups.length > 0 && (
    <Section id="experience" title={ui.sections.experience}>
      <div class="space-y-12">
        {groups.map((g) => (
          <div>
            {groups.length > 1 && <h3 class="mb-5 text-lg font-semibold">{g.title}</h3>}
            <ol class="space-y-6 border-l border-line">
              {g.entries.map((e) => (
                <li class="relative pl-6">
                  <span class="absolute -left-[5px] top-2.5 h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span>
                  {e.period && <p class="text-sm text-muted">{e.period}</p>}
                  <p class="font-semibold">{e.title}</p>
                  <p class="text-muted">{e.organization}</p>
                  {e.description && <p class="mt-2 max-w-[40rem]">{e.description}</p>}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </Section>
  )
}
