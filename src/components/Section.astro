---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line py-16 md:py-24">
  <div class="container-page grid gap-8 md:grid-cols-12 md:gap-10">
    <h2 id={`${id}-title`} class="text-2xl font-semibold tracking-tight md:col-span-4 md:sticky md:top-24 md:self-start">
      {title}
    </h2>
    <div class="md:col-span-8">
      <slot />
    </div>
  </div>
</section>
