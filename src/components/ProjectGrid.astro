---
import type { Project } from '../lib/projects';
import { ui } from '../data/ui';
import ProjectCard from './ProjectCard.astro';

interface Props { projects: Project[]; columns?: 1 | 2 }
const { projects, columns = 2 } = Astro.props;
---

{
  projects.length === 0 ? (
    <p class="text-muted">{ui.projects.empty}</p>
  ) : (
    <ul class:list={['grid gap-6', columns === 2 && 'sm:grid-cols-2']}>
      {projects.map((p) => (<li class="flex"><div class="flex w-full"><ProjectCard project={p} /></div></li>))}
    </ul>
  )
}
