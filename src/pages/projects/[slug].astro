---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import { getProjects } from '../../lib/projects';
import { ui } from '../../data/ui';
import { withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const paragraphs = (text?: string) => (text ? text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : []);
const meta = [
  { label: ui.projects.year, value: data.date ? String(data.date.getFullYear()) : undefined },
  { label: ui.projects.role, value: data.role },
  { label: ui.projects.status, value: data.status },
].filter((m) => m.value);
const { demo, repo } = data.links;
---

<BaseLayout title={data.title} description={data.summary} image={data.cover} type="article" noindex={data.draft}>
  <article class="container-page py-12 md:py-20">
    <a href={withBase('/projects/')} class="text-sm text-muted hover:text-ink">← {ui.projects.back}</a>

    <header class="mt-6 max-w-3xl">
      <h1 class="text-[clamp(2.25rem,6vw,4.25rem)] font-bold leading-[1.02] tracking-[-0.03em]">{data.title}</h1>
      <p class="mt-5 text-xl text-muted">{data.summary}</p>
      {data.draft && <p class="mt-3 font-medium text-accent">{ui.projects.draft}</p>}

      {
        (demo || repo) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {demo && <a class="btn btn-primary" href={demo} target="_blank" rel="noopener">{ui.projects.demo}<span class="sr-only"> (откроется в новой вкладке)</span></a>}
            {repo && <a class="btn btn-secondary" href={repo} target="_blank" rel="noopener">{ui.projects.repo}<span class="sr-only"> (откроется в новой вкладке)</span></a>}
          </div>
        )
      }
    </header>

    <div class="mt-10 aspect-[16/9] overflow-hidden rounded-xl border border-line">
      <ProjectImage
        src={data.cover}
        alt={data.coverAlt ?? ''}
        fallbackLabel={data.title}
        eager
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1152px) 1120px, 100vw"
      />
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-12">
      <aside class="md:col-span-4">
        {
          meta.length > 0 && (
            <dl class="space-y-4 border-t border-line pt-4">
              {meta.map((m) => (
                <div>
                  <dt class="text-sm text-muted">{m.label}</dt>
                  <dd class="font-medium">{m.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        {
          data.technologies.length > 0 && (
            <div class="mt-6 border-t border-line pt-4">
              <h2 class="text-sm text-muted">{ui.projects.technologies}</h2>
              <ul class="mt-3 flex flex-wrap gap-2">
                {data.technologies.map((t) => (<li class="tag">{t}</li>))}
              </ul>
            </div>
          )
        }
      </aside>

      <div class="space-y-12 md:col-span-8">
        {
          paragraphs(data.problem).length > 0 && (
            <section aria-labelledby="problem">
              <h2 id="problem" class="text-2xl font-semibold tracking-tight">{ui.projects.problem}</h2>
              <div class="mt-4 max-w-[42rem] space-y-4 text-lg">{paragraphs(data.problem).map((p) => (<p>{p}</p>))}</div>
            </section>
          )
        }
        {
          paragraphs(data.solution).length > 0 && (
            <section aria-labelledby="solution">
              <h2 id="solution" class="text-2xl font-semibold tracking-tight">{ui.projects.solution}</h2>
              <div class="mt-4 max-w-[42rem] space-y-4 text-lg">{paragraphs(data.solution).map((p) => (<p>{p}</p>))}</div>
            </section>
          )
        }
        <div class="prose-content text-lg"><Content /></div>
      </div>
    </div>

    {
      data.gallery.length > 0 && (
        <section aria-labelledby="gallery" class="mt-16 border-t border-line pt-10">
          <h2 id="gallery" class="text-2xl font-semibold tracking-tight">{ui.projects.gallery}</h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2">
            {data.gallery.map((g) => (
              <li>
                <figure>
                  <div class="aspect-[16/10] overflow-hidden rounded-xl border border-line">
                    <ProjectImage src={g.src} alt={g.alt} fallbackLabel={g.alt} widths={[480, 800, 1120]} sizes="(min-width: 1152px) 550px, (min-width: 640px) 50vw, 100vw" />
                  </div>
                  {g.caption && <figcaption class="mt-2 text-sm text-muted">{g.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (prev || next) && (
        <nav aria-label="Другие проекты" class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
          <div>
            {prev && (
              <a href={withBase(`/projects/${prev.id}/`)} class="block rounded-lg p-2 hover:text-accent">
                <span class="block text-sm text-muted">← {ui.projects.prev}</span>
                <span class="text-lg font-semibold">{prev.data.title}</span>
              </a>
            )}
          </div>
          <div class="sm:text-right">
            {next && (
              <a href={withBase(`/projects/${next.id}/`)} class="block rounded-lg p-2 hover:text-accent">
                <span class="block text-sm text-muted">{ui.projects.next} →</span>
                <span class="text-lg font-semibold">{next.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</BaseLayout>
